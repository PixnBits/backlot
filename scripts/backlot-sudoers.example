# Example sudoers fragment for Backlot jailer sittings on a dev machine.
# sudoers.d does NOT allow wildcards — exact command path only.
#
# Install (as a user who can still sudo with a password, once):
#   sudo cp scripts/backlot-sudoers.example /etc/sudoers.d/backlot
#   sudo chmod 440 /etc/sudoers.d/backlot
#   sudo visudo -c
#
# Then, from this worktree:
#   sudo -n ./scripts/m2test-root.sh
#   sudo -n ./scripts/m3test-root.sh
#
# Optional: add the kvm-capable user to group kvm:
#   sudo usermod -aG kvm pixnbits

pixnbits ALL=(ALL) NOPASSWD: /home/pixnbits/projects/backlot/feature/m3-compose-cp/scripts/m2test-root.sh
pixnbits ALL=(ALL) NOPASSWD: /home/pixnbits/projects/backlot/feature/m3-compose-cp/scripts/m3test-root.sh

Defaults! /home/pixnbits/projects/backlot/feature/m3-compose-cp/scripts/m2test-root.sh env_keep += "BACKLOT_ROOT FIRECRACKER_BIN JAILER_BIN"
Defaults! /home/pixnbits/projects/backlot/feature/m3-compose-cp/scripts/m3test-root.sh env_keep += "BACKLOT_ROOT FIRECRACKER_BIN JAILER_BIN"
